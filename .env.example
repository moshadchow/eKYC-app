# ── Database ──────────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/ekyc
DB_ECHO=false

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=eKYC Onboarding API
APP_VERSION=1.0.0
DEBUG=false

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-use-32-char-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MINUTES=30

# ── Biometric retry limits (BFIU guidelines) ──────────────────────────────────
BIOMETRIC_MAX_ATTEMPTS_PER_SESSION=10
BIOMETRIC_MAX_SESSIONS_PER_DAY=2
BIOMETRIC_MAX_TOTAL_SESSIONS=3

# ── BFIU risk thresholds (BDT) ────────────────────────────────────────────────
SIMPLIFIED_BO_THRESHOLD_BDT=1500000
SIMPLIFIED_LIFE_SUM_ASSURED_BDT=2000000
SIMPLIFIED_LIFE_PREMIUM_BDT=250000
SIMPLIFIED_NON_LIFE_PREMIUM_BDT=250000
HIGH_RISK_SCORE_THRESHOLD=15
EDD_DEADLINE_DAYS=30

# ── Storage ───────────────────────────────────────────────────────────────────
STORAGE_BUCKET=ekyc-documents
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# ── OCR extraction ────────────────────────────────────────────────────────────
# Provider: "mock" (dev/test) | "aws_textract" | "google_vision"
OCR_PROVIDER=mock
OCR_API_KEY=
OCR_API_ENDPOINT=
# Minimum confidence score to accept OCR result (0.0–1.0)
OCR_CONFIDENCE_THRESHOLD=0.60

# ── EC (Election Commission) verification ────────────────────────────────────
# Provider: "mock" (dev/test) | "real" (production Bangladesh EC API)
EC_PROVIDER=mock
EC_API_ENDPOINT=
EC_API_KEY=
